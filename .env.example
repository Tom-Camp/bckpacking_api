# Copy to .env and fill in. Loaded by app/utils/config.py and docker-compose.yml.

# Required
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
POSTGRES_USER=bp
POSTGRES_PASSWORD=change-me
POSTGRES_DB=bp

# Optional (defaults shown)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
LOG_LEVEL=INFO
JSON_LOGS=false

# Optional: this user is promoted to an active admin on startup
# ADMIN_EMAIL=you@example.com

# Optional: JSON list of allowed origins (not needed for the UI dev server, which proxies /api)
# CORS_ORIGINS=["http://localhost:5173"]
