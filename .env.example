# Copy to .env and fill in. Loaded by app/utils/config.py and docker-compose.yml.
# Don't quote values: `docker run --env-file` (the image, on the server) passes quotes through literally.

# Required
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
POSTGRES_USER=bp
POSTGRES_PASSWORD=change-me
POSTGRES_DB=bp

# Optional (defaults shown)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
LOG_LEVEL=INFO
# JSON_LOGS=false  # the Docker image defaults to true; set false only for local runs

# Docker image only (defaults shown): the address uvicorn binds to. Local `uvicorn`/`fastapi dev` ignore these.
# Keep 127.0.0.1 on the server, which runs the image with --network host behind nginx.
UVICORN_HOST=127.0.0.1
UVICORN_PORT=5300

# Optional: this user is promoted to an active admin on startup
# ADMIN_EMAIL=you@example.com

# Optional: JSON list of allowed origins (not needed for the UI dev server, which proxies /api)
# CORS_ORIGINS=["http://localhost:5173"]

# Optional: email via Resend (https://resend.com). Without RESEND_API_KEY, emails aren't sent: the app logs
# email_not_configured at WARNING and the body (including any reset link) at DEBUG only.
# RESEND_API_KEY=
# EMAIL_FROM must be an address on the domain verified in Resend (default shown)
# EMAIL_FROM=bckpack.ing <no-reply@bckpack.ing>
# The UI origin that links in emails point to (default shown). https://bckpack.ing on the server.
# APP_BASE_URL=http://localhost:5173

# Dev only: password for the accounts scripts/seed.py creates (must pass the registration strength check).
# The seed script refuses to run while this is empty, so never set it on a server. Leave the value out here.
SEED_PASSWORD=
